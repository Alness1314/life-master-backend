APP_IMAGE_TAG=0.0.1-development
APP_VERSION=0.0.1-development
SPRING_PROFILES_ACTIVE=prod
PORT=8080
PREFIX=/api/v1

DB_URL_NAME=jdbc:postgresql://cloud-host:5432/lifemaster?sslmode=require
DB_USERNAME=replace-me
DB_PASSWORD=replace-me

JWT_SECRET=replace-with-at-least-32-random-bytes
DEFAULT_PASS=replace-with-a-strong-initial-password

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=replace-me
EMAIL_PASSWORD=replace-me

SERVER_URL=https://goniac-mervin-lactationally.ngrok-free.dev
SERVER_DESCRIPTION=LifeMaster production
CORS_ALLOWED_ORIGINS=https://life-master-frontend-v2.vercel.app

SWAGGER_ENABLED=false
REMINDERS_ENABLED=false
RECURRING_SCHEDULER_ENABLED=true
FINANCIAL_ALERTS_SCHEDULER_ENABLED=true

FILES_ROOT=/app/data/files
FILES_MAX_SIZE_BYTES=10485760
BANK_IMPORT_MAX_SIZE_BYTES=20971520
TZ=America/Mexico_City
JAVA_TOOL_OPTIONS=-Duser.timezone=America/Mexico_City
